---
import ArrowRight from "phosphor-astro/ArrowRightBold.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Divider from "../components/Divider.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import CozyCorner from "../components/CozyCorner.astro";
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";

const latestPost = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="shell">
      <div class="layout">
        <section class="hero">
          <h1 class="hero-title">
            I build <span class="accent">cozy</span> and <span class="accent"
              >fun
            </span> interfaces
          </h1>
          <p class="hero-sub">
            Hi, I'm Liza. I make things for the web, and try to write about it
            as I go.
          </p>
          <div class="hero-ctas">
            <a href="/blog" class="cta cta-primary"
              >Read my writings <ArrowRight width="16" />
            </a>
            <a href="/about" class="cta cta-outlined">About</a>
          </div>
        </section>
        <Divider />
        <div class="posts-head">
          <h2 class="posts-title">Latest writings</h2>
          <a href="/blog" class="pill"
            >All writings <ArrowRight width="16" /></a
          >
        </div>
        <ol class="posts" role="list">
          {
            latestPost.map((post) => (
              <BlogCard
                url={`/blog/${post.id}/`}
                title={post.data.title}
                tag={post.data.tag}
                postedDate={post.data.pubDate}
                description={post.data.description}
                headingLevel="h2"
              />
            ))
          }
        </ol>
      </div>
    </main>
    <CozyCorner />
    <Footer />
  </body>
</html>
<style>
.hero,
  .layout > :global(.plant-divider) {
    grid-column: 1 / span 2;
  }
 
  .hero{
	display: flex;
	flex-direction: column;
	align-items: center;
	text-align: center;
  }

  .hero h1 {
    margin: 0;
    font-size: var(--t-display);
    line-height: var(--lh-display);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-wrap: balance;
    max-width: 36rem;
  }

  .hero-title .accent {
    color: var(--accent-text);
  }

  .hero-sub {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
    color: rgba(var(--text-primary), 0.8);
	max-width: 30rem;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
	margin: 1rem 0 0;
	justify-content: center;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Raleway", system-ui, sans-serif;
    padding: 9px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--t-small);
    transition: background-color 0.15s ease, color 0.15s ease, border-color: 0.15s ease, transform: 0.15s ease;
  }

  .cta:active {
    transform: translateY(1px);
    transition-duration: 0.06s;
  }

  .cta-primary {
    background: var(--accent-dark);
    color: var(--bg-primary);
  }

  .cta-primary:hover {
    background: var(--accent-text-hover);
    transform: translateY(-2px);
  }

  .cta-outlined {
    background: transparent;
    border: 1px solid rgba(var(--text-primary), 0.35);
    color: rgb(var(--text-primary));
  }

  .cta-outlined:hover {
    border-color: var(--accent-text);
    color: var(--accent-text);
    transform: translateY(-2px);
  }

  .posts {
    grid-column: 1 / span 2;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .posts-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 0 1rem;
    grid-column: 1 / span 2;
  }

  .posts-title {
    font-size: var(--t-title);
    font-weight: 600;
    color: rgb(var(--text-primary));
    margin: 0;
  }



  @media (max-width: 58rem) {
    .hero,
    .posts,
    .posts-head,
    .layout > :global(.plant-divider) {
      grid-column: 1;
    }
  }
</style>
