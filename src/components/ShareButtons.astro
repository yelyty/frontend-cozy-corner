---
import ShareFat from "phosphor-astro/ShareFatBold.astro";
import RedditLogoBold from "phosphor-astro/RedditLogoBold.astro"
import LinkedinLogoBold from "phosphor-astro/LinkedinLogoBold.astro";
interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const links = [
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
	icon: LinkedinLogoBold
  },
  {
    name: "Reddit",
    href: `https://www.reddit.com/submit?url=${u}&title=${t}`,
    icon: RedditLogoBold,
  },
];
---

<div class="share-links">
  <button
    class="share-button"
    id="share-button"
    data-title={title}
    data-url={url}
    ><ShareFat width="16" />Share
  </button>
  {
    links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener noreferrer">
        <l.icon />
        {l.name}
      </a>
    ))
  }
  <button id="copy-link" data-url={url} type="button">
    <svg
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      width="16"
      height="16"
    >
      <path
        d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
      ></path>
    </svg>
    <span id="copy-label">Copy link</span>
  </button>
</div>

<script>
  document.getElementById("copy-link")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(btn.dataset.url!);
    const label = btn.querySelector("#copy-label");
    if (!label) return;
    const prev = label.textContent;
    label.textContent = "Copied!";
    setTimeout(() => (label.textContent = prev), 1500);
  });

  const shareButton = document.getElementById("share-button");

  if (shareButton) {
    const shareData = {
      title: shareButton.dataset.title!,
      // temporary text
      text: "Visit Frontend Cozy Corner",
      url: shareButton.dataset.url!,
    };

    if (!navigator.canShare?.(shareData)) {
      shareButton.hidden = true;
    } else {
      shareButton.addEventListener("click", async () => {
        try {
          await navigator.share(shareData);
        } catch (err) {
          if ((err as Error).name !== "AbortError") console.error(err);
        }
      });
    }
  }
</script>

<style>
  .wrapper {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .share-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--bg-primary);
    border: 1px solid rgba(var(--text-primary), 0.15);
    color: rgb(var(--text-primary));
    text-decoration: none;
    font-size: 14px;
    font-family: inherit;
    line-height: 1;
    box-sizing: border-box;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color: 0.15s ease, transform: 0.15s ease;
  }
  .share-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    text-align: center;
  }

  .share-links a,
  .share-links button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--bg-primary);
    border: 1px solid rgba(var(--text-primary), 0.15);
    color: rgb(var(--text-primary));
    text-decoration: none;
    font-size: 14px;
    font-family: inherit;
    line-height: 1;
    box-sizing: border-box;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color: 0.15s ease, transform: 0.15s ease;
  }

  .share-links a svg,
  .share-links button svg {
    width: 16px;
    height: 16px;
    color: var(--accent-text);
    transition: color 0.25s ease;
  }

  .share-links a:hover,
  .share-links button:hover {
    background: var(--accent-text);
    border-color: var(--accent);
    color: var(--bg-primary);
    transform: translateY(-2px);
  }

  .share-links a:hover svg,
  .share-links button:hover svg {
    color: var(--bg-primary);
  }

  .share-links a:focus-visible,
  .share-links button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
