---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";
import { SITE_TITLE } from "../consts";
---

<header>
  <nav aria-label="Primary">
    <a href="/" class="logo-link" aria-label={SITE_TITLE}>
      <Logo />
    </a>

    <div class="menu" id="nav-menu">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Writings</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>
    <div class="nav-controls">
      <ThemeToggle />
      <button
        class="burger"
        id="burger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div class="progress" aria-hidden="true"></div>
  </nav>

  <script type="module" is:inline>
    function initMenu() {
      const burger = document.getElementById("burger");
      const navMenu = document.getElementById("nav-menu");

      if (!burger || !navMenu) return;

      function setMenu(open) {
        burger.setAttribute("aria-expanded", String(open));
        burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        burger.classList.toggle("open", open);
        navMenu.classList.toggle("open", open);
        if (open) navMenu.querySelector("a")?.focus();
      }

      burger.addEventListener("click", () => {
        setMenu(burger.getAttribute("aria-expanded") !== "true");
      });
      document.addEventListener("click", (e) => {
        if (burger.getAttribute("aria-expanded") !== "true") return;
        if (!navMenu?.contains(e.target) && !burger.contains(e.target)) {
          setMenu(false);
        }
      });
      navMenu
        ?.querySelectorAll("a")
        .forEach((link) =>
          link.addEventListener("click", () => setMenu(false)),
        );
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setMenu(false);
      });
    }
    document.addEventListener("astro:page-load", initMenu);
  </script>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--bg-primary);
    padding-block: 1.1rem;
    z-index: 100;
  }
  .logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
    min-width: 0;
    text-decoration: none;
  }

  .logo-link svg {
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    width: min(100% - 3rem, 44rem);
    margin-inline: auto;
  }

  .menu {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.2em;
    font-family: "Raleway", system-ui, sans-serif;
    font-size: var(--t-small);
    margin-left: auto;
  }

  .menu a {
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    color: rgb(var(--text-primary));
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .menu a:hover {
    background: rgba(var(--text-primary), 0.06);
    text-decoration: underline;
  }

  .menu a.active {
    color: var(--accent-text);
    background: none;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .burger {
    display: none;
    position: static;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1001;
  }
  .burger span {
    display: block;
    width: 28px;
    height: 3px;
    margin: 4px 0;
    background: var(--accent);
    border-radius: 2px;
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }
  .burger.open span:nth-child(1) {
    transform: translateY(11px) rotate(45deg);
  }
  .burger.open span:nth-child(2) {
    opacity: 0;
  }
  .burger.open span:nth-child(3) {
    transform: translateY(-11px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .burger {
      display: flex;
    }
    .menu {
      visibility: hidden;
      position: absolute;
      top: 100%;
      right: 10px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-width: 200px;
      background: var(--bg-primary);
      border-radius: 10px;
      border: 1px solid var(--accent-dark);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
      padding: 0.5em 0;
      z-index: 2000;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }
    .menu.open {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
      visibility: visible;
    }
    .menu a {
      display: block;
      width: 100%;
      padding: 0.85em 1.5em;
      text-align: left;
    }
    .menu a.active {
      background: transparent;
    }
    .logo {
      height: 44px;
    }
  }

  .progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 3px;
    width: 100%;
    background: var(--accent-text);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    :root {
      timeline-scope: --article;
    }
    :global(.prose) {
      view-timeline: --article block;
    }
    .progress {
      animation: progress-grow linear both;
      animation-timeline: --article;
      animation-range: contain 0% contain 100%;
    }
  }
  @keyframes progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
