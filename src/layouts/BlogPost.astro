---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ClockBold from "phosphor-astro/ClockBold.astro";
import ArrowLeft from "phosphor-astro/ArrowLeftBold.astro";
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Tag from '../components/Tag.astro';
import Divider from '../components/Divider.astro';
import CozyCorner from '../components/CozyCorner.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { tagSlug } from '../consts';
import PlantInBlossom from '../components/PlantInBlossom.astro';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	showTitle?: boolean;
	showDate?: boolean;
	tag?: string;
	goBack?: boolean;
	readingTime?: number;
	nextPost?: { url: string, title: string; description?: string};
	headings?: MarkdownHeading[];
};

const {
	title,
	description,
	pubDate,
	showTitle = true,
	showDate = true,
	tag,
	goBack = true,
	readingTime,
	nextPost,
	headings = []
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;
const tableOfContent = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<script>

	function placeTableOfContent() {
		const tableOfContent = document.querySelector<HTMLElement>(".prose > .toc");
		const firstHeading = document.querySelector<HTMLElement>(".prose > h2");
		if (!tableOfContent || !firstHeading || tableOfContent.dataset.placed) return;
		firstHeading.before(tableOfContent);
		tableOfContent.dataset.placed = "1";
	}
	placeTableOfContent();
	document.addEventListener("astro:page-load", placeTableOfContent);
</script>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		
	</head>

	<body>
		<Header />
		<main id="main" tabindex="-1">
			<article>
				<div class="prose">
					{goBack && <a href="/blog" class="pill"><ArrowLeft width="16px"/> All writings</a>}
					
					{showTitle && (
						
							<h1 class="title">{title}</h1>
							<div class="data">
						
						{showDate && pubDate && (
								<div class="date">
									<FormattedDate date={pubDate} />
								</div>
							)}
							{tag && <Tag state="link" href={`/blog/tag/${tagSlug(tag)}`} >{tag}</Tag>}
							<span class="readmeta"><ClockBold width="14" height="14" aria-hidden="true"/>{readingTime} min read</span>
					</div>
							<Divider />
					)}
					{tableOfContent.length > 1 && (<aside class="toc" aria-labelledby="toc-label"><p class="toc-label" id="toc-label">
						In this post</p><ol>{tableOfContent.map((h) => (<li class={h.depth === 3 ? "sub" : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>))}</ol></aside>)}
					<slot />
							<Divider />
							<p class="share-title">Like it? Share.</p>
							<ShareButtons title={title} url={url} />
				</div>
		{nextPost && (
			<nav class="read-next" aria-label="Read next">
				<span class="next-sprig"><PlantInBlossom /></span>
				<p class="next-label">Next in Frontend Cozy Corner</p>
				<a class="next-title" href={nextPost.url}>{nextPost.title}</a>
				{nextPost.description && (<p class="next-description">{nextPost.description}</p>)}
			</nav>
		)}
			</article>
		</main>
		<CozyCorner />
		<Footer />
	</body>
</html>
<style>
			html, body {
				margin: 0;
			}

			body {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}

			main {
				flex: 1 0 auto;
				display: flex;
				flex-direction: column;
				width:100%;
				margin: 0;
			}

			.prose {
				width: min(100% - 2 * var(--gutter), var(--shell));
				margin-inline: auto;
				padding: 0;
				color: rgba(var(--text-primary));
				text-align: left;
				text-wrap: pretty;
				hyphens: auto;
			}

			.prose > :global(:where(p, ul, ol, blockquote)) {
				max-width: var(--measure);
				text-align: justify;
				text-justify: inter-word;
				hyphens: auto;
			}

		 .prose :global(li)::marker {
    color: var(--accent-text);
  }

  .title, .prose :global(:where(h2,h3,h4)){
	hyphens: manual;
  }

			.title {
				font-size: var(--t-display);
				line-height: var(--lh-display);
				font-weight: 700;
				text-align: left;
				margin: 0.5rem 0 0.6rem;
				padding: 0;
			}

			.prose :global(:where(h2,h3)){
				font-weight: 700;
				letter-spacing: -0.015rem;
				text-align: left;
				font-size: var(--t-title);
				line-height: var(--lh-title);
				margin: var(--s-7) 0 var(--s-3);
				scroll-margin-top: 5.5rem;
			}

/* .prose a {
    color: var(--accent-text);
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0% 1.5px;
    transition: background-size 0.3s ease;
    padding-bottom: 2px;
  }
  .prose a:hover {
    background-size: 100% 1.5px;
  }
  .prose :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  } */

			.date {
				color: rgba(var(--text-primary));
				opacity: 0.7;
				font-size: var(--t-meta);
				font-variant-numeric: tabular-nums;
			}

			.data {
				display: flex;
				flex-flow: row wrap;
				justify-content: flex-start;
				align-items: center;
				gap: 0.6rem;
				margin: 0 0 1.5rem;
			}

			.readmeta {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				font-size: var(--t-meta);
			}

			.readmeta svg {
				flex: none;
				color: var(--accent-text);
			}

			.read-next {
				position: relative;
				width: min(100% - 2 * var(--gutter), var(--shell));
				margin: var(--s-8) auto 0;
				padding: var(--s-7) var(--s-5);
				border-radius: 22px;
				background: var(--bg-tint);
				text-align: center;
				transition: background 0.18s ease;
			}

			.next-sprig {
				display: block;
				width: 50px;
				height: 60px;
				margin: 0 auto var(--s-4);
			}

			.next-label {
				margin: 0;
				font-style: italic;
				font-size: var(--t-small);
				line-height: var(--lh-small);
				color: var(--accent-text);
			}

			.next-title {
				display: block;
				margin: 0;
				font-size: var(--t-section);
				line-height: var(--lh-title);
				font-weight: 700;
text-wrap: balance;
			}

			.next-title::after {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: 22px;
			}

			.read-next:hover .next-title, .next-title:hover{
				color: var(--accent-text-hover);
			}

			.read-next:hover .next-title:visited, .next-title:visited:hover {
				color: var(--visited-hover);
			}

			.next-description {
				max-width: 46ch;
				margin: var(--s-3) auto 0;
				font-size: var(--t-small);
				line-height: var(--lh-small);
				color:rgba(var(--text-primary), 0.8);
				text-align: center;
			}

			.share-title {
				text-align: center;
				font-size: var(--t-meta);
			}

			.toc {
				background: var(--bg-tint);
				border-radius: 12px;
				padding: 1.1rem 1.35rem;
				margin: 0 0 var(--s-6);
				font-family: Raleway, system-ui, sans-serif;
			}

			.toc-label {
				margin: 0 0 0.6rem;
				font-size: var(--t-meta);
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgba(var(--text-primary), 0.6);
			}

			.toc ol {
				margin:0;
				padding: 0;
				list-style: none;
				counter-reset: toc;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.toc li:not(.sub) {
				counter-increment: toc;
			}

			.toc a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.6rem;
				font-size: var(--t-small);
				font-weight: 600;
				color: rgba(var(--text-primary));
				text-decoration: none;
				border-bottom: 1px solid transparent;
				transition: color 0.15s ease, border-color 0.15s ease;
			}

			.toc a::before {
				content: counter(toc);
				font-size: var(--t-meta);
				font-weight: 700;
				font-variant-numeric: tabular-nums;
				color:var(--accent-text);
			}

			.toc a:hover {
				color: var(--accent-text);
				border-bottom-color: var(--accent);
			}

			.toc li.sub {
				margin-left: 1.4rem;
			}

			.toc li.sub a {
				font-weight: 500;
				color: rgba(var(--text-primary), 0.8);
			}

			.toc li.sub a::before {
				content: "\2014";
			}
		</style>
		