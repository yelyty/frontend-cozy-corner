---
import { ur } from "zod/locales";
import FormattedDate from "./FormattedDate.astro";
import Tag from "./Tag.astro";

interface Props {
  url: string;
  postedDate: Date;
  title: string;
  tag?: string;
  description?: string;
  headingLevel?: "h2" | "h3";
}

const {
  url,
  postedDate,
  title,
  tag,
  description,
  headingLevel = "h3",
} = Astro.props;
const Heading = headingLevel;
---

<article class="post-row">
  <div class="post-meta">
    <span class="post-date"><FormattedDate date={postedDate} /></span>
    {tag && <Tag size="large">{tag}</Tag>}
  </div>
  <Heading class="post-title"><a href={url}>{title}</a></Heading>
  {description && <p class="post-excerpt">{description}</p>}
</article>

<style>
  .post-row {
    padding: 1.9rem 0;
  }

  .post-row:not(:first-child) {
    border-top: 1px solid rgb(var(--text-primary), 0.12);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: "Raleway", system-ui, sans-serif;
  }

  .post-date {
    font-size: 13px;
    color: rgba(var(--text-primary), 0.8);
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0.45rem 0 0.3rem;
    line-height: 1.3;
  }

  .post-title a {
    color: rgb(var(--text-primary));
    text-decoration: none;
  }

  .post-title a:hover {
    color: var(--accent-text-hover);
  }

  .post-excerpt {
    font-size: 1rem;
    color: rgba(var(--text-primary), 0.8);
    margin: 0;
    max-width: 28rem;
    line-height: 1.55;
  }
</style>
