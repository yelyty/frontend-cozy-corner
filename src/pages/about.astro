---
import Divider from "../components/Divider.astro";
import profilePhoto from "../assets/me.jpeg";
import SocialLinks from "../components/SocialLinks.astro";
import Tag from "../components/Tag.astro";
import { SITE_TITLE } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import CozyCorner from "../components/CozyCorner.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`About | ${SITE_TITLE}`}
      description="Software engineer with 6+ years across frontend and backend in React and Node ecosystem. I write about things frontend things I do or learn on the way"
    />
  </head>
  <body>
    <Header />
    <main class="shell" id="main" tabindex="-1">
      <div class="layout">
        <div class="hero">
          <h1>
            <span class="accent-text">Frontend </span>by choice, <span
              class="accent-text">backend</span
            > when asked
          </h1>
          <div class="profile-photo-frame">
            <img
              class="profile-photo"
              src={profilePhoto.src}
              width={profilePhoto.width}
              height={profilePhoto.height}
              alt="Illustrated portrait of Liza"
              decoding="async"
              loading="lazy"
            />
          </div>
        </div>
        <div class="profile">
          <div class="profile-text">
            <p class="profile-lede">
              Hi, I'm Liza, a product-minded software engineer with over 6 years
              of experience in React and Node.js ecosystem, mostly on interfaces
              people use every day.
            </p>
            <p class="profile-lede">
              I push back on a design spec and catch the edge case before it's
              built. I've worked on both ends of the stack and I keep choosing
              frontend. That's the reason why this blog exists.
            </p>
            <p class="profile-aside">
              The cozy corner is a real place: an armchair at home, surrounded
              by too many plants, where I read in the evening. That's the place
              where ideas come to my mind.
            </p>
          </div>
        </div>
        <Divider />
        <section class="tech-section">
          <h2 class="section-label">What I work with</h2>
          <p class="tech-group">Languages</p>
          <div class="tech-row">
            <Tag size="large">Javascript</Tag>
            <Tag size="large">Typescript</Tag>
          </div>
          <p class="tech-group">Frontend</p>
          <div class="tech-row">
            <Tag size="large">React</Tag>
            <Tag size="large">React Native</Tag>
            <Tag size="large">Next.js</Tag>
            <Tag size="large">React Router</Tag>
            <Tag size="large">HTML</Tag>
            <Tag size="large">CSS</Tag>
            <Tag size="large">MUI</Tag>
            <Tag size="large">Tailwind</Tag>
            <Tag size="large">Storybook</Tag>
            <Tag size="large">Redux</Tag>
            <Tag size="large">Urql</Tag>
            <Tag size="large">GraphQL</Tag>
            <Tag size="large">REST API</Tag>
          </div>
          <p class="tech-group">Backend</p>
          <div class="tech-row">
            <Tag size="large">Node.js</Tag>
            <Tag size="large">Drizzle</Tag>
            <Tag size="large">Supabase</Tag>
            <Tag size="large">AWS</Tag>
            <Tag size="large">DynamoDB</Tag>
            <Tag size="large">SQLite</Tag>
          </div>
          <p class="tech-group">Testing</p>
          <div class="tech-row">
            <Tag size="large">Playwright</Tag>
            <Tag size="large">Cypress</Tag>
            <Tag size="large">Vitest</Tag>
          </div>
          <p class="tech-group">Day to day</p>
          <div class="tech-row">
            <Tag size="large">Github</Tag>
            <Tag size="large">Claude Code</Tag>
            <Tag size="large">Postman</Tag>
            <Tag size="large">Zod</Tag>
          </div>
        </section>
        <Divider />
        <div class="social-links-wrapper">
          <h2 class="social-title">Get in touch</h2>
          <p class="social-note">
            LinkedIn is where I answer. GitHub is where the code lives.
          </p>
          <SocialLinks />
        </div>
      </div>
    </main>
    <CozyCorner />
    <Footer />
  </body>
</html>

<style>
  .layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .layout > :global(*) {
    grid-column: 1;
  }

  .profile {
    display: flex;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .profile-photo-frame {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    border-radius: 20px;
    overflow: hidden;
  }

  .profile-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile p {
    flex: 1;
    line-height: 1.75;

    /* margin: 0; */
  }

  @media (max-width: 520px) {
    .profile {
      flex-direction: column;
    }
  }

  .social-links-wrapper {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .social-title {
    font-size: var(--t-section);
    line-height: var(--t-title);
    font-weight: 700;
    margin: 0 0 var(--s-2);
  }

  .timeline {
    position: relative;
    padding-left: 34px;

    --rail-pad: 34px;
    --rail-x: 9px;
    --rail-w: 2px;
    --dot-size: 15px;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-section);
    line-height: var(--lh-section);
    font-weight: 700;
    margin: 0 0 var(--s-5);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--accent);
  }

  .stop {
    position: relative;
    margin-bottom: var(--s-7);
  }

  .stop:last-child {
    margin-bottom: 0;
  }

  .dot {
    position: absolute;
    left: calc(var(--rail-x) - var(--rail-pad) - var(--dot-size) / 2);
    top: 6px;
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background: var(--accent);
    border: 4px solid var(--bg-primary);
    box-shadow: 0 0 0 1px rgba(var(--text-primary), 0.12);
  }

  .stop h3 {
    font-weight: 700;
    font-size: var(--t-title);
    line-height: var(--lh-title);
    color: rgba(var(--text-primary));
    margin-bottom: 6px;
  }

  .stop > p {
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.7;
  }

  .timeline li {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
    line-height: 1.55;
  }

  .timeline li::before {
    content: "\25C6";
    position: absolute;
    left: 0;
    top: 3px;
    color: var(--accent-text);
    font-size: 0.7em;
  }

  .achievements-list {
    padding-left: 0;
  }

  .hero {
    text-align: left;
    margin: 0 0 2.5rem;
    display: flex;
    justify-content: space-between;
  }

  .hero h1 {
    font-size: var(--t-display);
    line-height: var(--lh-display);
    max-width: 22ch;
    text-wrap: balance;
    margin: 0;
    align-self: flex-end;
  }

  .layout a {
    color: var(--accent-text);
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% /
      0% 1.5px;
    transition: background-size 0.3s ease;
    padding-bottom: 2px;
  }

  .layout a:hover {
    background-size: 100% 1.5px;
  }

  .profile p,
  .stop > p,
  .achievements-list {
    max-width: var(--measure);
  }

  .profile-text {
    flex: 1;
    min-width: 0;
    text-align: justify;
  }

  .profile-lede {
    margin: 0;
    line-height: 1.75;
  }

  .profile-lede + .profile-lede {
    margin-top: var(--s-4);
  }

  .profile-aside {
    display: block;
    margin: 0;
    margin-top: var(--s-3);

    /* margin: var(--s-4) 0 0; */
    color: rgba(var(--text-primary), 0.8);
    font-style: italic;
    line-height: 1.75;
  }

  .social-note {
    margin: 0 0 var(--s-4);
    color: rgba(var(--text-primary), 0.8);
    text-align: center;
  }

  .tech-section {
    margin-top: var(--s-5);
    margin-bottom: var(--s-5);
  }

  .tech-group {
    margin: var(--s-5) 0 var(--s-3);
    font-size: var(--t-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--text-primary), 0.8);
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .tech {
    font-family: Raleway, system-ui, sans-serif;
    font-size: 0.88em;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--accent-text);
  }

  .accent-text {
    color: var(--accent-text);
  }
</style>
