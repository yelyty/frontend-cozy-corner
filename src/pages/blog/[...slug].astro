---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { undefined } from "astro:schema";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post, i) => {
    const next = posts[(i + 1) % posts.length];
    return {
      params: { slug: post.id },
      props: {
        post,
        nextPost: next && {
          url: `/blog/${next.id}`,
          title: next.data.title,
          description: next.data.description,
        },
      },
    };
  });
}
type Props = {
  post: CollectionEntry<"blog">;
  nextPost?: { url: string; title: string; description?: string };
};

const { post, nextPost } = Astro.props;
const { Content } = await render(post);

const words = post?.body?.split(/\s+/).filter(Boolean).length || 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BlogPost {...post.data} readingTime={readingTime} nextPost={nextPost}>
  <Content />
</BlogPost>
