---
import PlantSprout from "./PlantSprout.astro";
---

<div class="plant-divider" role="presentation">
  <span class="plant-divider-line"></span>
  <span class="plant-divider-icon"><PlantSprout /></span>
  <span class="plant-divider-line"></span>
</div>
<style>
  .plant-divider {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 2.5rem 0;
  }

  .plant-divider-line {
    flex: 1;
    height: 1px;
    background: rgba(var(--text-primary), 0.12);
  }

  .plant-divider-icon {
    flex: 0 0 auto;
    width: 20px;
    height: 26px;
    display: block;
  }
</style>
