---
import SwatchCard from "../../SwatchCard.astro";
import Swatches from "../../Swatches.astro";
---

<Swatches>
  <SwatchCard label="navigator.wakeLock" labelPosition="top">
    <span class="dot" data-feature="wakeLock"></span>
    <h4 class="title">Keep the screen awake</h4>
    <p class="description">For checklists, recipes</p>
    <button class="btn" id="keep-awake">Keep awake</button>
  </SwatchCard>
  <SwatchCard label="navigator.vibrate" labelPosition="top">
    <span class="dot" data-feature="vibrate"></span>
    <h4 class="title">Haptic feedback</h4>
    <p class="description">Give user physical feedback</p>
    <button class="btn" id="buzz">Buzzzzz</button>
  </SwatchCard>
  <SwatchCard label="online/offline" labelPosition="top">
    <span class="dot" data-feature="onLine"></span><h4 class="title">
      Know the connection
    </h4>
    <p class="description">
      Tell user that it's the connection, not your web is broken
    </p>
    <span id="connection-label" class="connection-status">Online</span>
  </SwatchCard>
</Swatches>
<script>
  const likelyHandled =
    matchMedia("(pointer: coarse)").matches && navigator.maxTouchPoints > 0;
  const supports: Record<string, boolean> = {
    wakeLock: "wakeLock" in navigator,
    vibrate: "vibrate" in navigator && likelyHandled,
    onLine: "onLine" in navigator,
  };

  document
    .querySelectorAll<HTMLElement>(".dot[data-feature]")
    .forEach((dot) => {
      const ok = supports[dot.dataset.feature ?? ""] ?? false;
      dot.classList.toggle("is-available", ok);
      dot.title = ok ? "Supported" : "Not supported";
    });

  // Keep awake
  const keepAwakeButton = document.getElementById(
    "keep-awake",
  ) as HTMLButtonElement | null;

  if (keepAwakeButton) {
    let sentinel: WakeLockSentinel | null = null;
    let wanted = false;

    const setPressed = (on: boolean) => {
      keepAwakeButton.textContent = on ? "Staying awake" : "Keep awake";
      keepAwakeButton.setAttribute("aria-pressed", String(on));
    };

    const acquire = async () => {
      try {
        sentinel = await navigator.wakeLock.request("screen");
        sentinel.addEventListener("release", () => {
          sentinel = null;
          if (!wanted) setPressed(false);
        });
        setPressed(true);
      } catch {
        wanted = false;
        keepAwakeButton.disabled = true;
        keepAwakeButton.textContent = "Unavailable";
      }
    };

    if (!supports.wakeLock) {
      keepAwakeButton.disabled = true;
      keepAwakeButton.textContent = "Unavailable";
    } else {
      keepAwakeButton.addEventListener("click", async () => {
        if (sentinel) {
          wanted = false;
          await sentinel.release();
          return;
        }
        wanted = true;
        await acquire();
      });

      document.addEventListener("visibilitychange", async () => {
        if (document.visibilityState === "visible" && wanted && !sentinel) {
          acquire();
        }
      });
    }
  }

  // haptic feedback
  const buzzButton = document.getElementById(
    "buzz",
  ) as HTMLButtonElement | null;

  if (buzzButton) {
    if (!supports.vibrate) {
      buzzButton.disabled = true;
      buzzButton.textContent = "Unavailable";
    } else {
      buzzButton.addEventListener("click", () => {
        const ok = navigator.vibrate([40, 30, 40, 30, 120]);
        if (!ok) {
          buzzButton.textContent = "Blocked!";
          setTimeout(() => (buzzButton.textContent = "Buzzzzz"), 1200);
        }
      });
    }
  }

  // offline online
  const connectionLabel = document.getElementById("connection-label");

  if (connectionLabel) {
    const render = () => {
      const online = navigator.onLine;
      connectionLabel.textContent = online ? "Online" : "Offline";
    };
    render();
    window.addEventListener("online", render);
    window.addEventListener("offline", render);
  }
</script>
<style>
  .dot {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c0392b;
  }

  .dot.is-available {
    background: #2ecc71;
  }

  .btn {
    border: none;
    background: #a85757;
    color: #fff6ec;
    font-weight: 600;
    font-size: 13.5px;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
  }

  .title {
    margin: 0;
  }

  .description {
    margin: 0;
    color: rgba(var(--text-primary), 0.8);
    font-size: var(--t-small);
    text-align: left;
  }

  .connection-status {
    text-transform: uppercase;
    font-weight: 700;
    font-family: Raleway, system-ui, sans-serif;
  }
</style>
