---
import ArrowRight from "phosphor-astro/ArrowRightBold.astro";
import Divider from "../components/Divider.astro";
import profilePhoto from "../assets/me.jpeg";
import SocialLinks from "../components/SocialLinks.astro";
import Tag from "../components/Tag.astro";
import { SITE_TITLE } from "../consts";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import CozyCorner from "../components/CozyCorner.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`About | ${SITE_TITLE}`}
      description="Software engineer with 6+ years across frontend and backend, happiest in the frontend and pretty UIs"
    />
  </head>
  <body>
    <Header />
    <main class="shell" id="main">
      <div class="layout">
        <div class="hero">
          <h1>Frontend by choice, backend when asked</h1>
          <div class="profile-photo-frame">
            <img
              class="profile-photo"
              src={profilePhoto.src}
              width={profilePhoto.width}
              height={profilePhoto.height}
              alt="Illustrated portrait of Liza"
              decoding="async"
              loading="lazy"
            />
          </div>
        </div>
        <div class="profile">
          <div class="profile-text">
            <p class="profile-lede">
              Hi, I'm Liza, a product-minded software engineer with over 6 years
              of experience in React and Node.js ecosystem. I push back on a
              design spec and catch the edge case before it's built. I've worked
              on both ends of the stack and I keep choosing frontend. That's the
              reason why this blog exists.
            </p>
            <p class="profile-aside">
              When I'm not coding, you can find me hiking in the mountains,
              reading, or exploring new places, which is where the most of my
              ideas come from.
            </p>
          </div>
        </div>
        <Divider />
        <section class="timeline-section">
          <h2 class="section-label">Where I've worked</h2>

          <div class="timeline">
            <section class="stop">
              <span class="dot"></span>
              <h3>Four apps for senior care</h3>
              <p>
                An American startup connecting senior-care providers with
                families. It constists of a few apps: <span class="tech"
                  >React Native</span
                > mobile app for iOS and Android,<span class="tech">React</span> web
                application,
                <span class="tech">React Native</span> TV app for Android TV and Amazon
                Alexa skill.
              </p>
              <ul class="achievements-list">
                <li>
                  Build features for <span class="tech">React</span> and <span
                    class="tech">TypeScript</span
                  > web app in a <span class="tech">Yarn/Turborepo</span> monorepo.
                  Features include messaging, administration with tables and <span
                    class="tech">Formik</span
                  > forms, chat bots UI, integration with third-party services UI.
                </li>
                <li>
                  Build <span class="tech">React Native</span> mobile, including its
                  messaging feature
                </li>
                <li>
                  Maintain a shared component library documented and design
                  tokens in <span class="tech">Storybook</span>
                </li>
                <li>
                  Work closely with design and product, translating intent into
                  production ui
                </li>
                <li>
                  Style the app with <span class="tech">Material UI</span> and <span
                    class="tech">Emotion</span
                  >
                </li>
                <li>
                  Write unit tests with <span class="tech">Vitest</span>, <span
                    class="tech">Playwright</span
                  > specs for testing end-to-end flows and fixtures
                </li>
                <li>
                  Instrument the apps with <span class="tech">Sentry</span> for error
                  and performance monitoring
                </li>
                <li>
                  Manage client state with <span class="tech"
                    >Redux Toolkit</span
                  >, <span class="tech">redux-saga</span> for async flows and subscriptions,
                  and later lead the migration of that surface to <span
                    class="tech">Urql</span
                  >
                </li>
                <li>
                  Build <span class="tech">Next.js</span> app styles with <span
                    class="tech">Tailwind</span
                  > for display Digital Signage slides, rendered by Android TV app
                  written in
                  <span class="tech">React Native </span>
                </li>
              </ul>
            </section>

            <section class="stop">
              <span class="dot"></span>
              <h3>Service-center platform railways</h3>
              <p>
                Green-field project. Manufacturers and their customers share one
                system to track equipment, schedule service, and file warranty
                claims.
              </p>
              <ul class="achievements-list">
                <li>Set up <span class="tech">React</span> web application</li>
                <li>
                  Built dashboards, multi-step forms and tables with <span
                    class="tech">Bootstrap</span
                  >
                </li>
              </ul>
            </section>
            <section class="stop">
              <span class="dot"></span>
              <h3>A social app for sport clubs</h3>
              <p>
                Web application that helps users to find and join different
                sport events in the city, to meet like-minded people for sport
                activities, with a built-in attendance system and tournaments
                organization for event organizers.
              </p>
              <ul class="achievements-list">
                <li>
                  Maintained existing features of <span class="tech">React</span
                  > web application from the era when components were still classes,
                  in JavaScript.
                </li>
                <li>
                  Built several screens: Facebook-like social feed, Blog UI,
                  personal profile and achievements dashboard using <span
                    class="tech">Bootstrap</span
                  > and <span class="tech">SCSS</span> for the visuals.
                </li>
                <li>
                  Maintained localization of the app with <span class="tech"
                    >i18next</span
                  >
                </li>
                <li>
                  Managed app state in <span class="tech">Redux</span> and fetched
                  data over <span class="tech">GraphQL</span>
                </li>
              </ul>
            </section>
          </div>
        </section>
        <Divider />
        <section class="tech-section">
          <h2 class="section-label">What I work with</h2>
          <p class="tech-group">Language</p>
          <div class="tech-row">
            <Tag size="large">Javascript</Tag>
            <Tag size="large">Typescript</Tag>
          </div>
          <p class="tech-group">Frontend</p>
          <div class="tech-row">
            <Tag size="large">React</Tag>
            <Tag size="large">React Native</Tag>
            <Tag size="large">Next.js</Tag>
            <Tag size="large">React Router</Tag>
            <Tag size="large">HTML</Tag>
            <Tag size="large">CSS</Tag>
            <Tag size="large">MUI</Tag>
            <Tag size="large">Tailwind</Tag>
            <Tag size="large">Redux</Tag>
            <Tag size="large">Urql</Tag>
            <Tag size="large">Graphql</Tag>
            <Tag size="large">Rest API</Tag>
          </div>
          <p class="tech-group">Backend</p>
          <div class="tech-row">
            <Tag size="large">Node.js</Tag>
            <Tag size="large">Drizzle</Tag>
            <Tag size="large">Supabase</Tag>
            <Tag size="large">AWS</Tag>
            <Tag size="large">DynamoDB</Tag>
            <Tag size="large">Sqllite</Tag>
          </div>
          <p class="tech-group">Other tools</p>
          <div class="tech-row">
            <Tag size="large">Github</Tag>
            <Tag size="large">Claude Code</Tag>
            <Tag size="large">Postman</Tag>
            <Tag size="large">Zod</Tag>
            <Tag size="large">Playwright</Tag>
            <Tag size="large">Cypress</Tag>
          </div>
        </section>
        <Divider />
        <div class="social-links-wrapper">
          <h2 class="social-title">Get in touch</h2>
          <p class="social-note">
            LinkedIn is where I answer. Github is where the code lives
          </p>
          <SocialLinks />
        </div>
      </div>
    </main>
    <CozyCorner />
    <Footer />
  </body>
</html>

<style>
  .layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .layout > :global(*) {
    grid-column: 1;
  }
  .profile {
    display: flex;
    align-items: flex-start;
    gap: var(--s-5);
  }
  .profile-photo-frame {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    border-radius: 20px;
    overflow: hidden;
  }
  .profile-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile p {
    flex: 1;
    line-height: 1.75;
    /* margin: 0; */
  }

  @media (max-width: 520px) {
    .profile {
      flex-direction: column;
    }
  }
  .social-links-wrapper {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .social-title {
    font-size: var(--t-section);
    line-height: var(--t-title);
    font-weight: 700;
    margin: 0 0 var(--s-2);
  }
  .timeline {
    position: relative;
    padding-left: 34px;

    --rail-pad: 34px;
    --rail-x: 9px;
    --rail-w: 2px;
    --dot-size: 15px;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-section);
    line-height: var(--lh-section);
    font-weight: 700;
    margin: 0 0 var(--s-5);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--accent);
  }

  .stop {
    position: relative;
    margin-bottom: var(--s-7);
  }

  .stop:last-child {
    margin-bottom: 0;
  }

  .dot {
    position: absolute;
    left: calc(var(--rail-x) - var(--rail-pad) - var(--dot-size) / 2);
    top: 6px;
    width: var(--dot-size);
    height: var(--dot-size);
    border-radius: 50%;
    background: var(--accent);
    border: 4px solid var(--bg-primary);
    box-shadow: 0 0 0 1px rgba(var(--text-primary), 0.12);
  }

  .stop h3 {
    font-weight: 700;
    font-size: var(--t-title);
    line-height: var(--lh-title);
    color: rgb(var(--text-primary));
    margin-bottom: 6px;
  }

  .stop h3 a {
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1.5px solid var(--secondary);
    transition: border-color 0.2s ease;
  }

  .stop h3 a:hover {
    border-color: var(--accent-text-hover);
  }

  .stop > p {
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.7;
  }

  .timeline li {
    list-style: none;
    padding: 0;
    margin: 0;

    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
    line-height: 1.55;
  }

  .timeline li::before {
    content: "\25C6";
    position: absolute;
    left: 0;
    top: 3px;
    color: var(--accent-text);
    font-size: 0.7em;
  }

  .achievements-list {
    padding-left: 0;
  }
  .hero {
    text-align: left;
    margin: 0 0 2.5rem;
    display: flex;
    justify-content: space-between;
  }

  .hero h1 {
    font-size: var(--t-display);
    line-height: var(--lh-display);
    max-width: 22ch;
    text-wrap: balance;
    margin: 0;
    align-self: flex-end;
  }

  .layout a {
    color: var(--accent-text);
    text-decoration: none;
    background: linean-gradient(var(--accent), var(--accent)) no-repeat 0 100% /
      0% 1.5px;
    transition: background-size 0.3s ease;
    padding-bottom: 2px;
  }

  .layout a:hover {
    background-size: 100% 1.5px;
  }

  .profile p,
  .stop > p,
  .achievements-list {
    max-width: var(--measure);
  }

  .profile-text {
    flex: 1;
    min-width: 0;
    text-align: justify;
  }
  .profile-lede {
    margin: 0;
    line-height: 1.75;
  }

  .profile-aside {
    display: block;
    margin: 0;
    margin-top: var(--s-3);
    /* margin: var(--s-4) 0 0; */
    color: rgba(var(--text-primary), 0.8);
    font-style: italic;
    line-height: 1.75;
  }

  .social-note {
    margin: 0 0 var(--s-4);
    color: rgba(var(--text-primary), 0.8);
    text-align: center;
  }

  .tech-section {
    margin-top: var(--s-5);
    margin-bottom: var(--s-5);
  }

  .tech-group {
    margin: var(--s-5) 0 var(--s-3);
    font-size: var(--t-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--text-primary), 0.8);
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .tech {
    font-family: "Raleway", system-ui, sans-serif;
    font-size: 0.88em;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--accent-text);
  }
</style>
