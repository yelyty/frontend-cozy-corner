---
import FormattedDate from "./FormattedDate.astro";
import Tag from "./Tag.astro";
import { tagSlug } from "../consts";

interface Props {
  url: string;
  postedDate: Date;
  title: string;
  tag?: string;
  description?: string;
  headingLevel?: "h2" | "h3";
}

const {
  url,
  postedDate,
  title,
  tag,
  description,
  headingLevel = "h3",
} = Astro.props;
const Heading = headingLevel;
---

<li class="post-row">
  <div class="post-meta">
    <span class="post-date"><FormattedDate date={postedDate} /></span>
    {
      tag && (
        <Tag size="large" state="link" href={`/blog/tag/${tagSlug(tag)}`}>
          {tag}
        </Tag>
      )
    }
  </div>
  <div class="post-body">
    <Heading class="post-title"><a href={url}>{title}</a></Heading>
    {description && <p class="post-excerpt">{description}</p>}
  </div>
</li>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 34rem);
    column-gap: 2rem;
    padding-block: 2rem;
    position: relative;
    transition: background 0.12s ease;
  }

  .post-row:hover {
    background-color: rgba(var(--text-primary), 0.035);
  }

  .post-row:not(:first-child) {
    border-top: 1px solid var(--line);
  }

  .post-meta {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    padding-top: 0.35rem;
    text-align: right;
  }

  .post-date {
    font-size: var(--t-meta);
    line-height: 1.25;
    color: rgba(var(--text-primary), 0.8);
    font-variant-numeric: tabular-nums;
    font-family: "Raleway", system-ui, sans-serif;
  }

  .post-body {
    grid-column: 2;
  }

  .post-title {
    font-size: var(--t-title);
    font-weight: 600;
    margin: 0 0 0.25rem;
    line-height: var(--lh-title);
    text-wrap: balance;
  }

  .post-title a {
    color: rgb(var(--text-primary));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(var(--text-primary), 0.25);
    text-underline-offset: 0.18em;
    transition:
      text-decoration-color 0.15s ease,
      color 0.15s ease;
  }

  .post-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-row:hover,
  .post-title a,
  .post-title a:hover {
    color: var(--accent-text-hover);
    text-decoration-color: var(--accent-text-hover);
  }

  .post-excerpt {
    font-size: var(--t-small);
    color: rgba(var(--text-primary), 0.8);
    margin: 0;
    max-width: 62ch;
    line-height: var(--lh-small);
  }

  @media (max-width: 58rem) {
    .post-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-meta,
    .post-body {
      grid-column: 1;
    }
    .post-meta {
      flex-direction: row;
      align-items: center;
      justify-self: flex-start;
      text-align: left;
      gap: 0.6rem;
      padding-top: 0;
      margin-bottom: 0.5rem;
    }
  }
</style>
