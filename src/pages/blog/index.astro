---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import BlogCard from "../../components/BlogCard.astro";
import Divider from "../../components/Divider.astro";
import PlantsWithGooglyEyes from "../../components/PlantsWithGooglyEyes.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Notes from the keyboard | ${SITE_TITLE}`}
      description={"Notes on front-end"}
    />
  </head>
  <body>
    <Header />
    <main>
      <header class="blog-header">
        <h1 class="hero-title">Notes from the keyboard</h1>
        <h3 class="lede">
          Half-formed thoughts about building for the web, finished just enough
          to be published.
        </h3>
      </header>
      <section>
        <ul>
          {
            posts.map((post) => (
              <li>
                <BlogCard
                  url={`/blog/${post.id}/`}
                  title={post.data.title}
                  tag={post.data.tag}
                  postedDate={post.data.pubDate}
                  description={post.data.description}
                />
              </li>
            ))
          }
        </ul>
      </section>
      <Divider />
      <p class="endnote">
        That's everything so far. More when there is something worth writing
        down.
      </p>
    </main>

    <PlantsWithGooglyEyes />
    <Footer />
  </body>
</html>
<style>
  main {
    width: 800px;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style-type: none;
    margin: 0;
    margin-top: 5rem;
    padding: 0;
  }
  ul li {
    width: 100%;
  }
  ul li * {
    text-decoration: none;
    transition: 0.2s ease;
  }
  ul li a {
    display: block;
  }
  .title {
    margin: 0;
    color: rgb(var(--text-primary));
    line-height: 1;
  }
  .date {
    margin: 0;
    color: rgb(var(--text-primary));
    opacity: 0.7;
  }
  ul li a:hover h4,
  ul li a:hover .date {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    ul {
      gap: 1rem;
    }
  }
  .blog-header {
    text-align: center;
    padding: 2.5rem 2rem 0;
    max-width: 620px;
    margin: 0 auto;
  }
  .endnote {
    max-width: 28rem;
    font-size: 1rem;
    color: rgb(var(--text-primary));
  }
  .lede {
    text-wrap: pretty;
    margin: 1rem 0 0;
    font-size: 1.25rem;
    line-height: 1.5;
    color: rgba(var(--text-primary), 0.8);
  }
</style>
