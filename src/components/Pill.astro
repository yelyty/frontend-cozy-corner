---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & HTMLAttributes<"button">;

const { href, ...rest } = Astro.props;
const El = href ? "a" : "button";
---

<El class="pill" href={href} type={href ? undefined : "button"} {...rest}>
  <slot />
</El>
<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid rgba(var(--text-primary), 0.2);
    font-family: Raleway, system-ui, sans-serif;
    font-size: 14px;
    color: rgba(var(--text-primary));
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .pill :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--accent-text);
    transition: color 0.25s ease;
  }

  .pill:hover {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
    color: var(--bg-primary);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .pill:hover :global(svg) {
    color: var(--bg-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .pill {
      transition:
        background-color 0.15s ease,
        color 0.15s ease,
        border-color 0.15s ease;
    }

    .pill:hover {
      transform: none;
    }
  }
</style>
