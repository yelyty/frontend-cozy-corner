---
interface Props {
  label: string;
  labelPosition?: "top" | "bottom";
}

const { label, labelPosition = "bottom" } = Astro.props;
---

<div class="card">
  {labelPosition === "top" && <span class="label">{label}</span>}
  <slot />
  {labelPosition === "bottom" && <span class="label">{label}</span>}
</div>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: #fff1e2;
    border: 1px solid #f0ddc9;
    border-radius: 14px;
    padding: 18px 16px;
    min-width: 124px;
  }

  .label {
    font-family: monospace;
    font-size: 11px;
    color: #a04f4f;
  }
</style>
