---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PlantsWithGooglyEyes from "../components/PlantsWithGooglyEyes.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .plants-wrapper {
        display: flex;
        flex-direction: column;
        gap: var(--s-6);
        min-height: 56vh;
        width: min(100% - 2 * var(--gutter), var(--shell));
        align-items: center;
        justify-content: center;
        text-align: center;
        margin-inline: auto;
      }
      .plants-wrapper .title {
        font-size: var(--t-display);
        line-height: var(--lh-display);
        max-width: 22ch;
        margin: 0;
      }
    </style></head
  >

  <body>
    <Header />
    <main>
      <div class="plants-wrapper">
        <h1 class="title">
          Could be a typo, could be me. Let's try the <a href="/">homepage</a>.
        </h1>
        <PlantsWithGooglyEyes position="static" />
      </div>
    </main>
    <Footer />
  </body>
</html>
