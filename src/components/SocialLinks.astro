---
import LinkedinLogoBold from "phosphor-astro/LinkedinLogoBold.astro";
import GithubLogoBold from "phosphor-astro/GithubLogoBold.astro";
import Pill from "./Pill.astro";
---

<div class="social-links">
  <Pill
    href="https://linkedin.com/in/lizatymosenko"
    target="_blank"
    rel="noopener"
  >
    <LinkedinLogoBold width="16" height="16" />
    LinkedIn
  </Pill>
  <Pill href="https://github.com/yelyty" target="_blank" rel="noopener">
    <GithubLogoBold width="16" height="16" />
    GitHub
  </Pill>
</div>
<style>
  .social-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
