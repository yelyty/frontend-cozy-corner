---
import ArrowRight from "phosphor-astro/ArrowRightBold.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Divider from "../components/Divider.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import SocialLinks from "../components/SocialLinks.astro";
import Tag from "../components/Tag.astro";
import CozyCorner from "../components/CozyCorner.astro";
import { getCollection } from "astro:content";

const latestPost = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 1);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="shell">
      <div class="layout">
        <section class="hero">
          <h1 class="hero-title">
            I build <span class="accent">cozy</span> and <span class="accent"
              >fun
            </span> interfaces
          </h1>
          <p class="hero-sub">
            Hi, I'm Liza. I make things for the web, and try to write about it
            as I go.
          </p>
          <div class="hero-ctas">
            <a href="/blog" class="cta cta-primary"
              >Read my writings <ArrowRight width="16" />
            </a>
            <a href="/about" class="cta cta-outlined">About</a>
          </div>
        </section>
        <Divider />
        <section class="posts-section">
          <div class="posts-head">
            <h2 class="posts-title">Latest writing</h2>
            <a href="/blog" class="posts-all"
              >All posts <ArrowRight width="16" /></a
            >
          </div>

          <div class="posts-list">
            <a class="post-card" href="/blog/forgotten-states-part-1/">
              <div class="post-meta">
                <span class="post-date">Jul 28</span>
                <Tag size="small">HTML & CSS</Tag>
              </div>
              <h3 class="post-card-title">
                Forgotten states: a reminder for pet projects (part 1)
              </h3>
              <p class="post-excerpt">
                Small details that you may miss in your personal projects
              </p>
            </a>
          </div>
        </section>
        <Divider />
        <SocialLinks />
      </div>
    </main>
    <CozyCorner />
    <Footer />
  </body>
</html>
<style>
  .hero {
    grid-column: 2;
  }

  .hero h1 {
    margin: 0;
    font-size: var(--t-display);
    line-height: var(--lh-display);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .hero-title .accent {
    color: var(--accent-text);
  }

  .hero-sub {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
    color: rgba(var(--text-primary), 0.8);
    max-width: var(--measure);
    margin: 1rem 0 0;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 2rem 0 0;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Raleway", system-ui, sans-serif;
    padding: 9px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--t-small);
    transition: all 0.25s ease;
  }

  .cta-primary {
    background: var(--accent-dark);
    color: var(--bg-primary);
  }

  .cta-primary:hover {
    background: var(--accent-text-hover);
    transform: translateY(-2px);
  }

  .cta-outlined {
    background: transparent;
    border: 1px solid rgba(var(--text-primary), 0.35);
    color: rgb(var(--text-primary));
  }

  .cta-outlined:hover {
    border-color: var(--accent-text);
    color: var(--accent-text);
    transform: translateY(-2px);
  }

  .posts-section {
    padding: 2.5rem 2rem 3rem;
  }

  .posts-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    max-width: 600px;
    margin: 0 auto 1.5rem;
  }

  .posts-title {
    font-size: 21px;
    font-weight: 500;
    color: rgb(var(--text-primary));
    margin: 0;
  }

  .posts-all {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 13px;
    color: var(--accent-text);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .posts-all:hover {
    color: var(--accent-text-hover);
  }

  .posts-list {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-card {
    display: block;
    background: var(--bg-primary);
    border: 1px solid rgba(var(--text-primary), 0.1);
    border-radius: 14px;
    padding: 1.1rem 1.3rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s ease;
  }

  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(var(--text-primary), 0.08);
  }

  .post-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 6px;
  }

  .post-date {
    font-size: 12px;
    color: rgba(var(--text-primary), 0.8);
    font-variant-numeric: tabular-nums;
  }

  .post-tag {
    font-size: 11px;
    padding: 2px 9px;
    border-radius: 999px;
    border: 1px solid var(--accent-dark);
    color: var(--accent-text);
  }

  .post-card-title {
    font-size: 18px;
    font-weight: 500;
    color: rgb(var(--text-primary));
    margin: 0 0 4px;
    line-height: 1.35;
  }

  .post-excerpt {
    font-size: 14px;
    color: rgba(var(--text-primary), 0.7);
    margin: 0;
    line-height: 1.55;
  }

  @media (max-width: 520px) {
    .posts-section {
      padding: 2rem 1.25rem 2.5rem;
    }
    .posts-head {
      margin-bottom: 1rem;
    }
    .post-card {
      padding: 1rem 1.1rem;
    }
  }
</style>
